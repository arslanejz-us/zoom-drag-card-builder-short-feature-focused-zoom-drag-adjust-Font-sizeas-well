{"0":{"fields":[{"type":"section","id":5,"formId":1,"label":"Introduction","adminLabel":"","isRequired":false,"size":"large","errorMessage":"","visibility":"visible","inputs":null,"displayOnly":true,"description":"","allowsPrepopulate":false,"inputMask":false,"inputMaskValue":"","inputMaskIsCustom":false,"maxLength":"","labelPlacement":"","descriptionPlacement":"","subLabelPlacement":"","placeholder":"","cssClass":"section-text intro-section-text","inputName":"","noDuplicates":false,"defaultValue":"","enableAutocomplete":false,"autocompleteAttribute":"","choices":"","conditionalLogic":"","productField":"","enableDisplayInColumns":"","enableEnhancedUI":0,"layoutGroupId":"58a39793","multipleFiles":false,"maxFiles":"","calculationFormula":"","calculationRounding":"","enableCalculation":"","disableQuantity":false,"displayAllCategories":false,"useRichTextEditor":false,"errors":[],"fields":""},{"type":"html","id":45,"formId":1,"label":"Introduction","adminLabel":"","isRequired":false,"size":"large","errorMessage":"","visibility":"visible","inputs":null,"displayOnly":true,"description":"","allowsPrepopulate":false,"inputMask":false,"inputMaskValue":"","inputMaskIsCustom":false,"maxLength":"","labelPlacement":"","descriptionPlacement":"","subLabelPlacement":"","placeholder":"","cssClass":"","inputName":"","noDuplicates":false,"defaultValue":"","enableAutocomplete":false,"autocompleteAttribute":"","choices":"","conditionalLogic":"","content":"<style>\n.lmgi-idcard-widget {\n  font-family: RefrigeratorDeluxe, Oswald !important;\n  padding-top: 10px;\n  font-weight: 400 !important;\n}\n.intro-text {\n    font-family: RefrigeratorDeluxe, Oswald !important;\n    font-weight: 400 !important;\n    font-size: 16px;\n}\n\n.lmgi-idcard-widget ul {\n    font-family: 'RefrigeratorDeluxe', 'Oswald' !important;\n    font-weight: 400;\n    font-size: 16px;\n}\n<\/style>\n\n<div class=\"lmgi-idcard-widget\">\n  <p class=\"intro-text\">\n    As part of your LMGI membership, you can order a complimentary custom ID card \u2014 one credit-card size and one lanyard-ready size for scouting. Each card can be personalized with your photo, text alignment, and an optional IMDb listing. Our system will generate QR codes that link to the LMGI Member Directory (ensure your dues are current) and to your IMDb profile if you choose to include it.\n  <\/p>\n\n  <h3>Key Features<\/h3>\n  <ul>\n    <li>One complimentary printing of each size per member.<\/li>\n    <li>Upload, position, and resize your photo for the perfect fit.<\/li>\n    <li>Optionally add your IMDb page \u2014 we will generate a unique QR code linking directly to it.<\/li>\n    <li>Built-in QR code verifies your active LMGI membership in our directory.<\/li>\n    <li>Cards ship directly from the printer \u2014 please confirm your mailing address and carefully review your layout before approving.<\/li>\n  <\/ul>\n\n  <p class=\"intro-text\">\n    This benefit helps you verify your professional status wherever your work takes you. We appreciate your participation in LMGI!\n  <\/p>\n<\/div>\n","disableMargins":true,"productField":"","layoutGridColumnSpan":12,"enableDisplayInColumns":"","enableEnhancedUI":0,"layoutGroupId":"2c2f68e4","multipleFiles":false,"maxFiles":"","calculationFormula":"","calculationRounding":"","enableCalculation":"","disableQuantity":false,"displayAllCategories":false,"useRichTextEditor":false,"errors":[],"fields":""},{"type":"section","id":46,"formId":1,"label":"Personal Information","adminLabel":"","isRequired":false,"size":"large","errorMessage":"","visibility":"visible","inputs":null,"displayOnly":true,"description":"","allowsPrepopulate":false,"inputMask":false,"inputMaskValue":"","inputMaskIsCustom":false,"maxLength":"","labelPlacement":"","descriptionPlacement":"","subLabelPlacement":"","placeholder":"","cssClass":"section-text","inputName":"","noDuplicates":false,"defaultValue":"","enableAutocomplete":false,"autocompleteAttribute":"","choices":"","conditionalLogic":"","pro